      g2.userData = {
        name: "Broken Shed & Debris Field #2",
        desc: "Secondary broken outbuilding requiring heavy machine demolition.",
        specs: "Status: Severe Aesthetic & Physical Blight"
      };
      interactiveObjects.push(g2);
      existingGroup.add(g2);

      // 3. Stagnant Unmanaged Non-Jurisdictional Silt Pond
      const pondGeo = new THREE.CircleGeometry(22, 24);
      pondGeo.rotateX(-Math.PI / 2);
      const pondMat = new THREE.MeshStandardMaterial({
        color: COLORS.murkyPondWater,
        roughness: 0.9,
        metalness: 0.05,
        transparent: true,
        opacity: 0.92
      });
      const pond = new THREE.Mesh(pondGeo, pondMat);
      pond.position.set(-35, 0.1, 28);
      pond.userData = {
        name: "Non-Jurisdictional Silt Pond (Pre-Development)",
        desc: "Stagnant 0.5-acre pond with 6-8 ft of uncompacted organic muck. Requires $750k dewatering, muck dredging, and engineered structural backfill to support hotel foundations.",
        specs: "Area: ~0.50 Acres | 18,000 CY Structural Fill Required"
      };
      interactiveObjects.push(pond);
      existingGroup.add(pond);

      // 4. Dense Forest Canopy & Overgrowth (Matching Google Earth Satellite image)
      for (let i = 0; i < 140; i++) {
        const ex = -85 + Math.random() * 185;
        const ez = -15 + Math.random() * 85;
        if (Math.abs(ex - (-10)) < 15 && Math.abs(ez - 8) < 15) continue;
        if (Math.abs(ex - (-35)) < 16 && Math.abs(ez - 28) < 16) continue;
        addTree(ex, ez, existingGroup, true, 0.85 + Math.random() * 0.5);
      }
    }

    function onDocumentClick(event) {
      if (isTourActive) return;

      mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
      mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(interactiveObjects, true);

      if (intersects.length > 0) {
        let obj = intersects[0].object;
        while (obj && !obj.userData.name && obj.parent) {
          obj = obj.parent;
        }

        if (obj && obj.userData && obj.userData.name) {
          showInspector(obj.userData);
        }
      }
    }

    function showInspector(data) {
      const card = document.getElementById('inspector-card');
      document.getElementById('inspector-title').innerText = data.name;
      document.getElementById('inspector-desc').innerText = data.desc;

      const specsContainer = document.getElementById('inspector-specs');
      specsContainer.innerHTML = '';
      if (data.specs) {
        const parts = data.specs.split('|');
        parts.forEach(p => {
          const div = document.createElement('div');
          div.className = "flex items-center gap-1.5 text-slate-300";
          div.innerHTML = `<i class="fa-solid fa-chevron-right text-[8px] text-sky-400"></i> ${p.trim()}`;
          specsContainer.appendChild(div);
        });
      }
      card.classList.remove('hidden');
    }

    function closeInspector() {
      document.getElementById('inspector-card').classList.add('hidden');
    }

    function animateCameraTo(preset) {
      isTourActive = false;
      document.getElementById('tour-text').innerText = "Auto Orbit";
      document.getElementById('toggle-orbit-tour').classList.remove('bg-indigo-600', 'text-white');

      let targetPos = { x: 0, y: 180, z: 240 };
      let lookAtPos = { x: 0, y: 0, z: 0 };

      switch (preset) {
        case 'regional':
          // Distant zoom out showing Roundabout East, Hancock Health North, and the 6-Acre site
          targetPos = { x: 40, y: 440, z: 460 };
          lookAtPos = { x: 40, y: 0, z: -40 };
          break;
        case 'northStreet':
          // Zoomed onto the North Street-side angled parking bays
          targetPos = { x: -2, y: 65, z: -60 };
          lookAtPos = { x: -2, y: 0, z: -14 };
          break;
        case 'southBasins':
          // Zoomed onto the dual stormwater detention basins and retaining wall
          targetPos = { x: 0, y: 55, z: 155 };
          lookAtPos = { x: 0, y: -2, z: 85 };
          break;
        case 'roundabout':
          // Close zoom on the East Roundabout and W 200 N Bridge
          targetPos = { x: 220, y: 80, z: 60 };
          lookAtPos = { x: 220, y: 5, z: -38 };
          break;
        case 'northHealth':
          // Looking across W 200 N to Hancock Health Gateway campus
          targetPos = { x: -80, y: 110, z: -60 };
          lookAtPos = { x: -80, y: 15, z: -170 };
          break;
        case 'siteMaster':
          // Focused on the 6-Acre Dual Hotel lot
          targetPos = { x: 0, y: 120, z: 150 };
          lookAtPos = { x: 0, y: 5, z: 20 };
          break;
      }

      new TWEEN.Tween(camera.position)
        .to(targetPos, 1400)
        .easing(TWEEN.Easing.Cubic.Out)
        .start();

      new TWEEN.Tween(controls.target)
        .to(lookAtPos, 1400)
        .easing(TWEEN.Easing.Cubic.Out)
        .start();
    }

    function toggleTourMode() {
      isTourActive = !isTourActive;
      const btn = document.getElementById('toggle-orbit-tour');
      const text = document.getElementById('tour-text');
      if (isTourActive) {
        text.innerText = "Stop Orbit";
        btn.classList.add('bg-indigo-600', 'text-white');
      } else {
        text.innerText = "Auto Orbit";
        btn.classList.remove('bg-indigo-600', 'text-white');
      }
    }

    function switchState(state) {
      currentMode = state;
      const btnProp = document.getElementById('btn-mode-proposed');
      const btnExist = document.getElementById('btn-mode-existing');

      if (state === 'proposed') {
        btnProp.classList.add('active');
        btnExist.classList.remove('active');
        proposedGroup.visible = true;
        existingGroup.visible = false;
      } else {
        btnExist.classList.add('active');
        btnProp.classList.remove('active');
        proposedGroup.visible = false;
        existingGroup.visible = true;
      }
    }

    function setTimeOfDay(time) {
      if (time === 'day') {
        scene.background.setHex(0x060b17);
        scene.fog.color.setHex(0x060b17);
        directionalLight.color.setHex(0xfff7ed);
        directionalLight.intensity = 1.45;
        directionalLight.position.set(240, 300, 180);
        ambientLight.intensity = 0.55;
      } else if (time === 'sunset') {
        scene.background.setHex(0x381207);
        scene.fog.color.setHex(0x381207);
        directionalLight.color.setHex(0xf97316);
        directionalLight.intensity = 1.6;
        directionalLight.position.set(240, 60, 90);
        ambientLight.intensity = 0.38;
      } else if (time === 'night') {
        scene.background.setHex(0x02050e);
        scene.fog.color.setHex(0x02050e);
        directionalLight.color.setHex(0x38bdf8);
        directionalLight.intensity = 0.45;
        directionalLight.position.set(80, 140, 80);
        ambientLight.intensity = 0.22;
      }
    }

    function toggleLayer(layerName) {
      const isChecked = document.getElementById(`layer-${layerName}`).checked;
      switch (layerName) {
        case 'fairfield':
          fairfieldGroup.visible = isChecked;
          break;
        case 'holiday':
          holidayGroup.visible = isChecked;
          break;
        case 'northParking':
          northParkingGroup.visible = isChecked;
          break;
        case 'retaining':
          retainingGroup.visible = isChecked;
          break;
        case 'basins':
        case 'creek':
          waterGroup.visible = isChecked;
          break;
        case 'road':
          roadGroup.visible = isChecked;
          break;
        case 'north':
          northGroup.visible = isChecked;
          break;
      }
    }

    function updateCompass() {
      const rose = document.getElementById('compass-rose');
      if (!rose) return;
      const angle = Math.atan2(camera.position.x - controls.target.x, camera.position.z - controls.target.z);
      rose.style.transform = `rotate(${angle}rad)`;
    }

    function onWindowResize() {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    }

    function animate(time) {
      requestAnimationFrame(animate);

      TWEEN.update();

      if (isTourActive) {
        tourAngle += 0.003;
        const radius = 280;
        camera.position.x = Math.sin(tourAngle) * radius;
        camera.position.z = Math.cos(tourAngle) * radius;
        camera.position.y = 140 + Math.sin(tourAngle * 2) * 35;
        controls.target.set(0, 0, 0);
      }

      controls.update();
      updateCompass();

      // Water ripples
      if (creekMesh) {
        creekMesh.position.y = -6.8 + Math.sin(time * 0.002) * 0.08;
      }
      if (westBasinMesh) {
        westBasinMesh.position.y = -2.4 + Math.cos(time * 0.0025) * 0.05;
      }
      if (eastBasinMesh) {
        eastBasinMesh.position.y = -2.4 + Math.sin(time * 0.0025) * 0.05;
      }
      if (northLakeMesh) {
        northLakeMesh.position.y = -0.6 + Math.cos(time * 0.0018) * 0.04;
      }

      renderer.render(scene, camera);
    }

    // Modal & Elevation Tab Controllers
    function toggleElevationModal(open) {
      const modal = document.getElementById('elevations-modal');
      if (open) modal.classList.remove('hidden');
      else modal.classList.add('hidden');
    }

    function switchElevationTab(tab) {
      ['fairfield', 'holiday'].forEach(t => {
        const btn = document.getElementById(`tab-${t}`);
        const content = document.getElementById(`content-${t}`);
        if (t === tab) {
          btn.classList.add('active', 'text-white');
          btn.classList.remove('text-slate-400');
          content.classList.remove('hidden');
        } else {
          btn.classList.remove('active', 'text-white');
          btn.classList.add('text-slate-400');
          content.classList.add('hidden');
        }
      });
    }

    window.onload = function() {
      init();
    };
  </script>
</body>
