<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Buck Creek Overlook - 3D Civil Engineering & Regional Master Plan</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/tween.js/18.6.4/tween.umd.js"></script>

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background-color: #040814;
      color: #f1f5f9;
      user-select: none;
    }
    .mono {
      font-family: 'JetBrains Mono', monospace;
    }
    #webgl-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }
    .glass-panel {
      background: rgba(10, 18, 36, 0.90);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 20px 45px -15px rgba(0, 0, 0, 0.75);
    }
    ::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.5);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(94, 114, 148, 0.5);
      border-radius: 9999px;
    }
    .view-btn.active {
      background: linear-gradient(135deg, #0284c7, #2563eb);
      border-color: #38bdf8;
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(2, 132, 199, 0.45);
    }
    .elevation-tab.active {
      background: #0284c7;
      color: #ffffff;
      border-color: #38bdf8;
    }
  </style>
</head>
<body class="w-full h-full relative">

  <canvas id="webgl-canvas"></canvas>

  <!-- Top Navigation Bar & Title Header -->
  <header class="absolute top-3 left-3 right-3 z-20 flex flex-wrap items-center justify-between gap-2.5 pointer-events-none">
    <div class="glass-panel px-4 py-2 rounded-2xl flex items-center space-x-3 pointer-events-auto border border-sky-500/30">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 via-sky-500 to-emerald-500 flex items-center justify-center text-white shadow-lg shadow-sky-500/25">
        <i class="fa-solid fa-layer-group text-lg"></i>
      </div>
      <div>
        <div class="flex items-center space-x-2">
          <h1 class="text-sm sm:text-base font-bold tracking-tight text-white flex items-center gap-2">
            Buck Creek Overlook
            <span class="text-[10px] px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-semibold">6.00 AC Master CAD</span>
          </h1>
        </div>
        <p class="text-[11px] text-slate-300 flex items-center gap-1.5">
          <i class="fa-solid fa-location-dot text-rose-400 text-[10px]"></i>
          6165 W 200 N, Greenfield, IN &bull; 
          <span class="text-sky-300 font-medium">East: Buck Creek &amp; Roundabout &bull; North: Hancock Health</span>
        </p>
      </div>
    </div>

    <!-- Quick State Switcher & Environment Toolbar -->
    <div class="glass-panel p-1.5 rounded-2xl flex items-center space-x-1.5 pointer-events-auto">
      <button id="btn-mode-proposed" onclick="switchState('proposed')" class="view-btn active px-3.5 py-1.5 rounded-xl text-xs font-semibold flex items-center space-x-2 transition-all">
        <i class="fa-solid fa-hotel text-emerald-400"></i>
        <span>Proposed: Dual Hotels (193 Keys)</span>
      </button>
      <button id="btn-mode-existing" onclick="switchState('existing')" class="view-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all flex items-center space-x-2">
        <i class="fa-solid fa-triangle-exclamation text-amber-400"></i>
        <span>Existing: Trees, House &amp; Blight</span>
      </button>

      <button onclick="toggleElevationModal(true)" class="px-3 py-1.5 rounded-xl text-xs font-semibold text-sky-300 bg-sky-950/60 hover:bg-sky-900/60 border border-sky-500/40 transition flex items-center gap-1.5">
        <i class="fa-solid fa-ruler-combined"></i>
        <span>Elevations</span>
      </button>

      <div class="w-px h-5 bg-slate-700/60 mx-1"></div>
      <button id="btn-time-day" onclick="setTimeOfDay('day')" title="Daylight View" class="p-1.5 w-8 h-8 rounded-xl text-amber-300 bg-slate-800/80 hover:bg-slate-700 transition flex items-center justify-center">
        <i class="fa-solid fa-sun text-xs"></i>
      </button>
      <button id="btn-time-sunset" onclick="setTimeOfDay('sunset')" title="Golden Hour" class="p-1.5 w-8 h-8 rounded-xl text-orange-400 bg-slate-800/80 hover:bg-slate-700 transition flex items-center justify-center">
        <i class="fa-solid fa-cloud-sun text-xs"></i>
      </button>
      <button id="btn-time-night" onclick="setTimeOfDay('night')" title="Night Lighting" class="p-1.5 w-8 h-8 rounded-xl text-indigo-400 bg-slate-800/80 hover:bg-slate-700 transition flex items-center justify-center">
        <i class="fa-solid fa-moon text-xs"></i>
      </button>
    </div>
  </header>

  <!-- Bottom Camera Flyover Presets (Includes Super Zoom Out) -->
  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 pointer-events-auto">
    <div class="glass-panel px-3 py-2 rounded-2xl flex items-center gap-1.5 shadow-2xl border border-slate-700/70 overflow-x-auto max-w-[95vw]">
      <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider px-1 hidden md:inline-block">Zoom/View:</span>
      <button onclick="animateCameraTo('regional')" class="cam-btn px-2.5 py-1 rounded-xl bg-slate-800/80 hover:bg-sky-600/30 hover:text-sky-300 text-xs text-slate-200 transition flex items-center gap-1 border border-slate-700/50">
        <i class="fa-solid fa-globe text-[10px] text-sky-400"></i> Regional Overview (Full Zoom-Out)
      </button>
      <button onclick="animateCameraTo('northStreet')" class="cam-btn px-2.5 py-1 rounded-xl bg-slate-800/80 hover:bg-amber-600/30 hover:text-amber-300 text-xs text-slate-200 transition flex items-center gap-1 border border-slate-700/50">
        <i class="fa-solid fa-square-parking text-[10px] text-amber-400"></i> North Street-Side Parking
      </button>
      <button onclick="animateCameraTo('southBasins')" class="cam-btn px-2.5 py-1 rounded-xl bg-slate-800/80 hover:bg-cyan-600/30 hover:text-cyan-300 text-xs text-slate-200 transition flex items-center gap-1 border border-slate-700/50">
        <i class="fa-solid fa-water text-[10px] text-cyan-400"></i> South Storm Basins &amp; Wall
      </button>
      <button onclick="animateCameraTo('roundabout')" class="cam-btn px-2.5 py-1 rounded-xl bg-slate-800/80 hover:bg-emerald-600/30 hover:text-emerald-300 text-xs text-slate-200 transition flex items-center gap-1 border border-slate-700/50">
        <i class="fa-solid fa-circle-notch text-[10px] text-emerald-400"></i> East Roundabout
      </button>
      <button onclick="animateCameraTo('northHealth')" class="cam-btn px-2.5 py-1 rounded-xl bg-slate-800/80 hover:bg-rose-600/30 hover:text-rose-300 text-xs text-slate-200 transition flex items-center gap-1 border border-slate-700/50">
        <i class="fa-solid fa-hospital text-[10px] text-rose-400"></i> North: Hancock Health
      </button>
      <button onclick="animateCameraTo('siteMaster')" class="cam-btn px-2.5 py-1 rounded-xl bg-slate-800/80 hover:bg-sky-600/30 hover:text-sky-300 text-xs text-slate-200 transition flex items-center gap-1 border border-slate-700/50">
        <i class="fa-solid fa-maximize text-[10px] text-sky-400"></i> 6-Acre CAD Site
      </button>
      <button id="toggle-orbit-tour" onclick="toggleTourMode()" class="px-2.5 py-1 rounded-xl bg-indigo-600/30 hover:bg-indigo-600/50 text-indigo-300 text-xs font-semibold transition flex items-center gap-1 border border-indigo-500/40">
        <i class="fa-solid fa-play text-[9px]"></i> <span id="tour-text">Auto Orbit</span>
      </button>
    </div>
  </div>

  <!-- Left Side Control Panel: Civil Layers & Color Legend -->
  <aside class="absolute top-20 left-3 z-20 w-72 max-h-[calc(100vh-120px)] flex flex-col gap-2.5 pointer-events-auto overflow-y-auto pr-1">
    
    <!-- Civil CAD Layer Toggles -->
    <div class="glass-panel p-3.5 rounded-2xl border border-slate-700/60 text-xs">
      <div class="flex items-center justify-between mb-2">
        <h3 class="font-bold uppercase tracking-wider text-sky-400 flex items-center gap-1.5 text-[11px]">
          <i class="fa-solid fa-layer-group"></i> CAD Layout Layers
        </h3>
        <span class="text-[9px] text-slate-400 font-mono">SITE PLAN</span>
      </div>
      
      <div class="space-y-1.5">
        <label class="flex items-center justify-between p-1.5 rounded-xl bg-slate-800/50 hover:bg-slate-800/80 cursor-pointer transition">
          <span class="flex items-center gap-1.5 text-slate-200">
            <span class="w-2.5 h-2.5 rounded bg-sky-500 inline-block"></span> Fairfield Inn (West 97 Rms)
          </span>
          <input type="checkbox" id="layer-fairfield" checked onchange="toggleLayer('fairfield')" class="rounded border-slate-600 text-sky-500">
        </label>

        <label class="flex items-center justify-between p-1.5 rounded-xl bg-slate-800/50 hover:bg-slate-800/80 cursor-pointer transition">
          <span class="flex items-center gap-1.5 text-slate-200">
            <span class="w-2.5 h-2.5 rounded bg-blue-700 inline-block"></span> Holiday Inn (East 96 Rms)
          </span>
          <input type="checkbox" id="layer-holiday" checked onchange="toggleLayer('holiday')" class="rounded border-slate-600 text-sky-500">
        </label>

        <label class="flex items-center justify-between p-1.5 rounded-xl bg-slate-800/50 hover:bg-slate-800/80 cursor-pointer transition">
          <span class="flex items-center gap-1.5 text-slate-200">
            <span class="w-2.5 h-2.5 rounded bg-amber-400 inline-block"></span> North Street-Side Angled Parking
          </span>
          <input type="checkbox" id="layer-north-parking" checked onchange="toggleLayer('northParking')" class="rounded border-slate-600 text-sky-500">
        </label>
        
        <label class="flex items-center justify-between p-1.5 rounded-xl bg-slate-800/50 hover:bg-slate-800/80 cursor-pointer transition">
          <span class="flex items-center gap-1.5 text-slate-200">
            <span class="w-2.5 h-2.5 rounded bg-amber-600 inline-block"></span> Structural Retaining Walls
          </span>
          <input type="checkbox" id="layer-retaining" checked onchange="toggleLayer('retaining')" class="rounded border-slate-600 text-sky-500">
        </label>

        <label class="flex items-center justify-between p-1.5 rounded-xl bg-slate-800/50 hover:bg-slate-800/80 cursor-pointer transition">
          <span class="flex items-center gap-1.5 text-slate-200">
            <span class="w-2.5 h-2.5 rounded bg-cyan-500 inline-block"></span> Dual South Detention Basins
          </span>
          <input type="checkbox" id="layer-basins" checked onchange="toggleLayer('basins')" class="rounded border-slate-600 text-sky-500">
        </label>

        <label class="flex items-center justify-between p-1.5 rounded-xl bg-slate-800/50 hover:bg-slate-800/80 cursor-pointer transition">
          <span class="flex items-center gap-1.5 text-slate-200">
            <span class="w-2.5 h-2.5 rounded bg-blue-400 inline-block"></span> Buck Creek &amp; Riparian Border
          </span>
          <input type="checkbox" id="layer-creek" checked onchange="toggleLayer('creek')" class="rounded border-slate-600 text-sky-500">
        </label>

        <label class="flex items-center justify-between p-1.5 rounded-xl bg-slate-800/50 hover:bg-slate-800/80 cursor-pointer transition">
          <span class="flex items-center gap-1.5 text-slate-200">
            <span class="w-2.5 h-2.5 rounded bg-emerald-500 inline-block"></span> W 200 N, Bridge &amp; Roundabout
          </span>
          <input type="checkbox" id="layer-road" checked onchange="toggleLayer('road')" class="rounded border-slate-600 text-sky-500">
        </label>

        <label class="flex items-center justify-between p-1.5 rounded-xl bg-slate-800/50 hover:bg-slate-800/80 cursor-pointer transition">
          <span class="flex items-center gap-1.5 text-slate-200">
            <span class="w-2.5 h-2.5 rounded bg-rose-500 inline-block"></span> North Area: Hancock Health
          </span>
          <input type="checkbox" id="layer-north" checked onchange="toggleLayer('north')" class="rounded border-slate-600 text-sky-500">
        </label>
      </div>
    </div>

    <!-- Site Color Legend Matching CAD & Engineering Plan -->
    <div class="glass-panel p-3.5 rounded-2xl border border-slate-700/60 text-xs">
      <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">Master Color Reference</div>
      <div class="space-y-1.5 text-[11px] text-slate-300">
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2"><span class="w-3 h-3 rounded bg-sky-500 border border-sky-300"></span> Fairfield Inn (West)</span>
          <span class="mono text-slate-400 text-[10px]">97 Keys</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2"><span class="w-3 h-3 rounded bg-blue-700 border border-blue-400"></span> Holiday Inn Express (East)</span>
          <span class="mono text-slate-400 text-[10px]">96 Keys</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2"><span class="w-3 h-3 rounded bg-amber-400 border border-amber-300"></span> North Angled Bays</span>
          <span class="mono text-slate-400 text-[10px]">Street-Side</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2"><span class="w-3 h-3 rounded bg-cyan-600 border border-cyan-400"></span> Dual Storm Basins</span>
          <span class="mono text-slate-400 text-[10px]">South Retention</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2"><span class="w-3 h-3 rounded bg-amber-700 border border-amber-500"></span> Retaining Wall</span>
          <span class="mono text-slate-400 text-[10px]">Wall &amp; Jog</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2"><span class="w-3 h-3 rounded bg-emerald-600 border border-emerald-400"></span> Buck Creek Edge</span>
          <span class="mono text-slate-400 text-[10px]">Tree Line</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2"><span class="w-3 h-3 rounded bg-amber-500 border border-amber-300"></span> East Roundabout</span>
          <span class="mono text-slate-400 text-[10px]">W 200 N</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2"><span class="w-3 h-3 rounded bg-rose-700 border border-rose-400"></span> Hancock Health</span>
          <span class="mono text-slate-400 text-[10px]">North</span>
        </div>
      </div>
    </div>

    <!-- Active Object Tooltip / Inspector Box -->
    <div id="inspector-card" class="glass-panel p-3.5 rounded-2xl border border-sky-500/40 transition-all duration-300 hidden">
      <div class="flex items-center justify-between text-xs mb-1">
        <span class="font-bold text-sky-300 flex items-center gap-1.5">
          <i class="fa-solid fa-magnifying-glass-location text-sky-400"></i> Object Inspector
        </span>
        <button onclick="closeInspector()" class="text-slate-400 hover:text-white text-xs">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <h4 id="inspector-title" class="text-sm font-bold text-white mb-0.5">Fairfield Inn</h4>
      <p id="inspector-desc" class="text-xs text-slate-300 leading-normal"></p>
      <div id="inspector-specs" class="mt-2 pt-2 border-t border-slate-700/60 text-[11px] mono text-slate-300 flex flex-col gap-0.5"></div>
    </div>
  </aside>

  <!-- Top Right Orientation Compass & Context -->
  <div class="absolute top-20 right-3 z-20 pointer-events-auto flex flex-col items-end gap-2">
    <div class="glass-panel p-2.5 rounded-2xl border border-slate-700/60 flex flex-col items-center">
      <div class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mb-1">Orientation</div>
      <div id="compass-rose" class="relative w-12 h-12 rounded-full bg-slate-900/90 border border-slate-700 flex items-center justify-center transition-transform">
        <span class="absolute top-1 text-[8px] font-bold text-rose-500">N</span>
        <span class="absolute bottom-1 text-[8px] font-bold text-slate-400">S</span>
        <span class="absolute left-1 text-[8px] font-bold text-slate-400">W</span>
        <span class="absolute right-1 text-[8px] font-bold text-cyan-400">E</span>
        <div class="w-1 h-6 bg-gradient-to-t from-transparent via-rose-500 to-rose-400 rounded-full"></div>
      </div>
    </div>

    <!-- Quick Location Badge -->
    <div class="glass-panel p-2.5 rounded-2xl border border-slate-700/60 text-[10px] space-y-1 w-48">
      <div class="font-bold text-slate-300 flex items-center gap-1">
        <i class="fa-solid fa-compass text-sky-400"></i> Geographic Context
      </div>
      <div class="text-slate-400 leading-tight">
        &bull; <strong>North:</strong> W 200 N &amp; Hancock Health<br>
        &bull; <strong>North Frontage:</strong> Angled street-side stalls<br>
        &bull; <strong>East:</strong> Buck Creek, Bridge &amp; Roundabout<br>
        &bull; <strong>South:</strong> Dual Basins &amp; Retaining Wall<br>
        &bull; <strong>West:</strong> 12" PVC utility easement
      </div>
    </div>
  </div>

  <!-- Modal: Hotel Architectural Elevations & Prototype Sheets -->
  <div id="elevations-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-3 sm:p-6">
    <div class="glass-panel w-full max-w-4xl max-h-[90vh] rounded-3xl border border-sky-500/40 flex flex-col overflow-hidden shadow-2xl">
      <!-- Modal Header -->
      <div class="p-4 px-6 border-b border-slate-700/70 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-xl bg-sky-600/30 border border-sky-400/40 flex items-center justify-center text-sky-300">
            <i class="fa-solid fa-ruler-combined"></i>
          </div>
          <div>
            <h2 class="text-sm sm:text-base font-bold text-white">Hotel Architectural Elevations &amp; CAD Layout</h2>
            <p class="text-[11px] text-slate-400">4-Story Prototype Finishes &bull; Fairfield Inn (West) &amp; Holiday Inn Express (East)</p>
          </div>
        </div>
        <button onclick="toggleElevationModal(false)" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Elevation Tabs -->
      <div class="flex items-center px-6 pt-2.5 border-b border-slate-800 gap-2 bg-slate-900/50">
        <button id="tab-fairfield" onclick="switchElevationTab('fairfield')" class="elevation-tab active px-3.5 py-1.5 rounded-t-xl text-xs font-bold border-b-2 border-transparent transition flex items-center gap-1.5">
          <i class="fa-solid fa-hotel text-sky-400"></i> Fairfield Inn (West: 97 Rms)
        </button>
        <button id="tab-holiday" onclick="switchElevationTab('holiday')" class="elevation-tab px-3.5 py-1.5 rounded-t-xl text-xs font-bold text-slate-400 border-b-2 border-transparent transition flex items-center gap-1.5">
          <i class="fa-solid fa-building text-blue-400"></i> Holiday Inn Express (East: 96 Rms)
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-5 overflow-y-auto flex-1 space-y-4 text-xs">
        
        <!-- Fairfield Inn Elevations Content -->
        <div id="content-fairfield" class="space-y-3">
          <div class="grid grid-cols-3 gap-2">
            <div class="p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/50">
              <span class="text-slate-400 text-[10px]">Guest Rooms:</span>
              <div class="text-sm font-bold text-white mono">97 Keys &bull; 4 Stories</div>
            </div>
            <div class="p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/50">
              <span class="text-slate-400 text-[10px]">Parking Stalls:</span>
              <div class="text-sm font-bold text-sky-300 mono">101 Dedicated Stalls</div>
            </div>
            <div class="p-2.5 rounded-xl bg-slate-800/60 border border-slate-700/50">
              <span class="text-slate-400 text-[10px]">Building Height:</span>
              <div class="text-sm font-bold text-emerald-300 mono">48'-6" To Parapet</div>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 flex flex-col items-center">
            <div class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-2 self-start flex items-center gap-2">
              <i class="fa-solid fa-draw-polygon text-sky-400"></i> North Front Elevation (Marriott Prototype - Facing W 200 N Drive)
            </div>
            <svg viewBox="0 0 850 200" class="w-full h-auto max-h-48">
              <line x1="20" y1="180" x2="830" y2="180" stroke="#475569" stroke-width="2"/>
              <rect x="70" y="35" width="710" height="145" fill="#cbd5e1" stroke="#334155" stroke-width="2"/>
              <rect x="65" y="30" width="720" height="8" fill="#1e293b"/>
              <rect x="90" y="45" width="670" height="14" fill="#854d0e"/>
              <rect x="90" y="85" width="670" height="12" fill="#64748b"/>
              <rect x="90" y="125" width="670" height="12" fill="#64748b"/>
              <rect x="70" y="35" width="45" height="145" fill="#334155"/>
              <rect x="735" y="35" width="45" height="145" fill="#334155"/>
              <rect x="375" y="15" width="105" height="165" fill="#0f172a" stroke="#0284c7" stroke-width="2"/>
              <rect x="385" y="22" width="85" height="16" rx="3" fill="#0284c7"/>
              <text x="427" y="34" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle">FAIRFIELD</text>
              <rect x="350" y="120" width="155" height="10" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5"/>
              <rect x="360" y="130" width="8" height="50" fill="#475569"/>
              <rect x="487" y="130" width="8" height="50" fill="#475569"/>
