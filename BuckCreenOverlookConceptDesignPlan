    function addTree(x, z, targetGroup, isBlighted, scale = 1.0) {
      const treeGroup = new THREE.Group();

      const trunkH = (isBlighted ? 3.5 : 4.8) * scale;
      const trunkGeo = new THREE.CylinderGeometry(0.3 * scale, 0.5 * scale, trunkH, 6);
      const trunkMat = new THREE.MeshStandardMaterial({ color: isBlighted ? 0x2e241c : 0x543d2b, roughness: 0.9 });
      const trunk = new THREE.Mesh(trunkGeo, trunkMat);
      trunk.position.y = trunkH / 2;
      trunk.castShadow = true;
      treeGroup.add(trunk);

      const folH = (isBlighted ? 3.8 : 6.0) * scale;
      const folGeo = new THREE.DodecahedronGeometry(folH / 2, 1);
      const folMat = new THREE.MeshStandardMaterial({
        color: isBlighted ? 0x4a442e : 0x245828,
        roughness: 0.82,
        flatShading: true
      });
      const foliage = new THREE.Mesh(folGeo, folMat);
      foliage.position.y = trunkH + folH / 3;
      foliage.castShadow = true;
      treeGroup.add(foliage);

      treeGroup.position.set(x, 0, z);
      targetGroup.add(treeGroup);
    }

