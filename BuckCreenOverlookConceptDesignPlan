  <script>
    /* =========================================================================
       BUCK CREEK OVERLOOK 3D REGIONAL & CIVIL VISUALIZATION ENGINE
       Matches Google Earth Satellite Imagery & Civil Engineer CAD Layout:
       - Street-side angled parking bays on North
       - Dual Future Stormwater Detention Basins on South
       - Retaining walls with center jog & Tree Preservation Line on Southeast
       - Fairfield Inn (West 97 Rms) & Holiday Inn Express (East 96 Rms)
       - East Roundabout, W 200 N Bridge & Hancock Health North Campus
       ========================================================================= */

    let scene, camera, renderer, controls;
    let proposedGroup, existingGroup, fairfieldGroup, holidayGroup, retainingGroup, landscapeGroup, waterGroup, parkingGroup, northParkingGroup, roadGroup, northGroup;
    let directionalLight, ambientLight, hemisphereLight;
    let raycaster, mouse;
    let isTourActive = false;
    let tourAngle = 0;
    let currentMode = 'proposed';
    let creekMesh, westBasinMesh, eastBasinMesh, northLakeMesh;
    let interactiveObjects = [];

    // Distinct Visual Palette Tokens based on CAD and Google Earth
    const COLORS = {
      // Terrain & Surfaces
      grass: 0x2f4b27,
      grassBlight: 0x544e39,
      soil: 0x4a3b2b,
      riparianStone: 0x4b5563,

      // Roadways & Infrastructure
      asphalt: 0x161a22,
      concrete: 0x94a3b8,
      curb: 0xd1d5db,
      roadMarkingYellow: 0xfacc15,
      roadMarkingWhite: 0xffffff,
      roundaboutIsland: 0x1f3b20,

      // Fairfield Inn (West Hotel)
      fairfieldBody: 0xd1cfcb,
      fairfieldCharcoal: 0x1e293b,
      fairfieldCyan: 0x0284c7,
      fairfieldGlass: 0x38bdf8,

      // Holiday Inn Express (East Hotel)
      holidayBody: 0xf8fafc,
      holidayBlue: 0x1e3a8a,
      holidayStone: 0x78350f,
      holidayGlass: 0x60a5fa,

      // Water Systems
      creekWater: 0x135870,
      cleanBasinWater: 0x187a9e,
      murkyPondWater: 0x414833,
      northLakeWater: 0x1b6d8a,

      // Retaining Wall & Structures
      retainingWall: 0x475569,
      guardrail: 0x1e293b,

      // North Hancock Health
      hancockHospital: 0x334155,
      hancockRoof: 0x1e293b,
      waterTower: 0xe2e8f0
    };

    function init() {
      const canvas = document.getElementById('webgl-canvas');

      // 1. Scene Setup
      scene = new THREE.Scene();
      scene.background = new THREE.Color(0x060b17);
      scene.fog = new THREE.FogExp2(0x060b17, 0.0012);

      // 2. Camera Setup (Generous view to allow extreme zoom-out to regional roundabout and north)
      camera = new THREE.PerspectiveCamera(40, window.innerWidth / window.innerHeight, 1, 3500);
      camera.position.set(0, 240, 320);

      // 3. WebGL Renderer
      renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: false });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.15;

      // 4. OrbitControls with high maxDistance for deep zoom-out
      controls = new THREE.OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.05;
      controls.maxPolarAngle = Math.PI / 2.05;
      controls.minDistance = 20;
      controls.maxDistance = 1600; // Allows super zoom-out as requested
      controls.target.set(0, 0, 0);

      // 5. Lighting
      ambientLight = new THREE.AmbientLight(0xffffff, 0.55);
      scene.add(ambientLight);

      hemisphereLight = new THREE.HemisphereLight(0xdbeafe, 0x1e293b, 0.45);
      hemisphereLight.position.set(0, 300, 0);
      scene.add(hemisphereLight);

      directionalLight = new THREE.DirectionalLight(0xfff7ed, 1.45);
      directionalLight.position.set(240, 300, 180);
      directionalLight.castShadow = true;
      directionalLight.shadow.mapSize.width = 2048;
      directionalLight.shadow.mapSize.height = 2048;
      directionalLight.shadow.camera.near = 20;
      directionalLight.shadow.camera.far = 1000;
      const d = 380;
      directionalLight.shadow.camera.left = -d;
      directionalLight.shadow.camera.right = d;
      directionalLight.shadow.camera.top = d;
      directionalLight.shadow.camera.bottom = -d;
      directionalLight.shadow.bias = -0.0004;
      scene.add(directionalLight);

      // 6. Raycasting
      raycaster = new THREE.Raycaster();
      mouse = new THREE.Vector2();
      window.addEventListener('click', onDocumentClick, false);
      window.addEventListener('resize', onWindowResize, false);

      // 7. Component Groups
      proposedGroup = new THREE.Group();
      existingGroup = new THREE.Group();
      fairfieldGroup = new THREE.Group();
      holidayGroup = new THREE.Group();
      retainingGroup = new THREE.Group();
      landscapeGroup = new THREE.Group();
      waterGroup = new THREE.Group();
      parkingGroup = new THREE.Group();
      northParkingGroup = new THREE.Group();
      roadGroup = new THREE.Group();
      northGroup = new THREE.Group();

      scene.add(proposedGroup);
      scene.add(existingGroup);
      scene.add(roadGroup);
      scene.add(northGroup);

      proposedGroup.add(fairfieldGroup);
      proposedGroup.add(holidayGroup);
      proposedGroup.add(retainingGroup);
      proposedGroup.add(landscapeGroup);
      proposedGroup.add(waterGroup);
      proposedGroup.add(parkingGroup);
      proposedGroup.add(northParkingGroup);

      // Build Civil Model components
      buildRegionalTerrainMesh();
      buildW200NBridgeAndEastRoundabout();
      buildNorthHancockHealthCampus();
      buildBuckCreekRiverBed();
      buildRetainingWallsAndDualBasins();
      buildFairfieldInnModel();
      buildHolidayInnExpressModel();
      buildNorthStreetSideAngledParking();
      buildCivilParkingStallsAndAccess();
      buildLandscapingAndTrees();
      buildExistingBlightSiteModel();

      // Default Proposed
      existingGroup.visible = false;
      proposedGroup.visible = true;

      animate();
    }

    function buildRegionalTerrainMesh() {
      // Large regional plane to support distant zoom-out (950x750 units)
      const terrainGeo = new THREE.PlaneGeometry(950, 750, 96, 96);
      terrainGeo.rotateX(-Math.PI / 2);

      const pos = terrainGeo.attributes.position;
      for (let i = 0; i < pos.count; i++) {
        const x = pos.getX(i);
        const z = pos.getZ(i);

        let y = 0;

        // Buck Creek depression running North-South around X = 115 to 155
        if (x > 105 && x < 165) {
          const creekCenter = 135 + Math.sin(z * 0.02) * 8;
          const distToCreek = Math.abs(x - creekCenter);
          if (distToCreek < 18) {
            y = -7.5 + Math.cos(z * 0.04) * 0.8;
          } else {
            y = -((18 - Math.min(distToCreek, 30)) * 0.35);
          }
        }

        // East Roundabout Rise
        if (x > 175 && Math.abs(z - (-38)) < 90) {
          y = 0.5;
        }

        // North Hancock Health terrace (Z < -100)
        if (z < -100) {
          y = 1.0;
        }

        // Southern agricultural farmland (Z > 90)
        if (z > 90) {
          y = -0.5 + Math.sin(x * 0.08) * 0.25;
        }

        pos.setY(i, y);
      }
      terrainGeo.computeVertexNormals();

      const terrainMat = new THREE.MeshStandardMaterial({
        color: COLORS.grass,
        roughness: 0.9,
        metalness: 0.04,
        flatShading: true
      });
      const terrain = new THREE.Mesh(terrainGeo, terrainMat);
      terrain.receiveShadow = true;
      scene.add(terrain);

      // Southern Agricultural Farmland patch
      const farmGeo = new THREE.PlaneGeometry(620, 220);
      farmGeo.rotateX(-Math.PI / 2);
      const farmMat = new THREE.MeshStandardMaterial({
        color: COLORS.soil,
        roughness: 0.95
      });
      const farmPatch = new THREE.Mesh(farmGeo, farmMat);
      farmPatch.position.set(-20, -0.4, 210);
      farmPatch.receiveShadow = true;
      scene.add(farmPatch);
    }

    function buildW200NBridgeAndEastRoundabout() {
      // 1. W CR 200 N Road Surface running West to East (Z = -38)
      const roadGeo = new THREE.PlaneGeometry(660, 24);
      roadGeo.rotateX(-Math.PI / 2);
      const roadMat = new THREE.MeshStandardMaterial({
        color: COLORS.asphalt,
        roughness: 0.65,
        metalness: 0.1
      });
      const mainRoad = new THREE.Mesh(roadGeo, roadMat);
      mainRoad.position.set(-10, 0.45, -38);
      mainRoad.receiveShadow = true;
      roadGroup.add(mainRoad);

      // Center Raised Grass/Concrete Median on W 200 N (as shown on Google Earth)
      const medianGeo = new THREE.BoxGeometry(260, 0.4, 3.2);
      const medianMat = new THREE.MeshStandardMaterial({ color: 0x1f3b20, roughness: 0.7 });
      const median = new THREE.Mesh(medianGeo, medianMat);
      median.position.set(-30, 0.65, -38);
      roadGroup.add(median);

      // Yellow Median Curbs
      const curbGeo = new THREE.BoxGeometry(262, 0.45, 0.5);
      const curbMat = new THREE.MeshStandardMaterial({ color: COLORS.curb });
      const curbN = new THREE.Mesh(curbGeo, curbMat);
      curbN.position.set(-30, 0.65, -39.7);
      const curbS = curbN.clone();
      curbS.position.set(-30, 0.65, -36.3);
      roadGroup.add(curbN);
      roadGroup.add(curbS);

      // 2. Concrete Bridge Deck over Buck Creek (X = 115 to 155)
      const bridgeDeckGeo = new THREE.BoxGeometry(40, 1.2, 26);
      const bridgeMat = new THREE.MeshStandardMaterial({ color: 0xa1a1aa, roughness: 0.5 });
      const bridgeDeck = new THREE.Mesh(bridgeDeckGeo, bridgeMat);
      bridgeDeck.position.set(135, 0.5, -38);
      bridgeDeck.castShadow = true;
      bridgeDeck.receiveShadow = true;
      bridgeDeck.userData = {
        name: "W 200 N Bridge over Buck Creek",
        desc: "Highway bridge carrying W 200 N traffic across the Buck Creek stream corridor toward the East Roundabout.",
        specs: "Span: 120 LF | Concrete Girders | Eastern Property Gateway"
      };
      interactiveObjects.push(bridgeDeck);
      roadGroup.add(bridgeDeck);

      // Bridge Barriers / Parapets
      const barrierGeo = new THREE.BoxGeometry(40, 2.2, 1.2);
      const barrierMat = new THREE.MeshStandardMaterial({ color: 0xd4d4d8, roughness: 0.4 });
      const barN = new THREE.Mesh(barrierGeo, barrierMat);
      barN.position.set(135, 1.6, -50.4);
      const barS = new THREE.Mesh(barrierGeo, barrierMat);
      barS.position.set(135, 1.6, -25.6);
      roadGroup.add(barN);
      roadGroup.add(barS);

      // 3. EAST ROUNDABOUT (X = 220, Z = -38)
      const roundaboutGroup = new THREE.Group();
      roundaboutGroup.position.set(220, 0.5, -38);

      // Outer Asphalt Ring
      const ringGeo = new THREE.RingGeometry(18, 38, 48);
      ringGeo.rotateX(-Math.PI / 2);
      const ring = new THREE.Mesh(ringGeo, roadMat);
      ring.receiveShadow = true;
      roundaboutGroup.add(ring);

      // Concrete Truck Apron Ring
      const apronGeo = new THREE.RingGeometry(13, 18, 48);
      apronGeo.rotateX(-Math.PI / 2);
      const apronMat = new THREE.MeshStandardMaterial({ color: 0x94a3b8, roughness: 0.6 });
      const apron = new THREE.Mesh(apronGeo, apronMat);
      apron.position.y = 0.06;
      roundaboutGroup.add(apron);

      // Center Landscaped Island Mound
      const moundGeo = new THREE.CylinderGeometry(12.6, 12.8, 1.8, 36);
      const moundMat = new THREE.MeshStandardMaterial({ color: COLORS.roundaboutIsland, roughness: 0.7 });
      const mound = new THREE.Mesh(moundGeo, moundMat);
      mound.position.y = 0.9;
      roundaboutGroup.add(mound);

      // Roundabout Center Art / Gateway Marker
      const monumentGeo = new THREE.CylinderGeometry(1.4, 2.2, 8, 8);
      const monumentMat = new THREE.MeshStandardMaterial({ color: 0xf59e0b, metalness: 0.8, roughness: 0.2 });
      const monument = new THREE.Mesh(monumentGeo, monumentMat);
      monument.position.y = 5.0;
      monument.userData = {
        name: "W 200 N & Mt. Comfort Gateway Roundabout",
        desc: "Modern multi-lane roundabout directly east of Buck Creek. Connects traffic to I-70, Greenfield Corporate Park, and Hancock Gateway.",
        specs: "Status: Constructed & Signalized | Location: East Gateway"
      };
      interactiveObjects.push(monument);
      roundaboutGroup.add(monument);

      // Roundabout legs
      const legEastGeo = new THREE.PlaneGeometry(80, 24);
      legEastGeo.rotateX(-Math.PI / 2);
      const legEast = new THREE.Mesh(legEastGeo, roadMat);
      legEast.position.set(70, 0, 0);
      roundaboutGroup.add(legEast);

      const legNorthGeo = new THREE.PlaneGeometry(24, 80);
      legNorthGeo.rotateX(-Math.PI / 2);
      const legNorth = new THREE.Mesh(legNorthGeo, roadMat);
      legNorth.position.set(0, 0, -70);
      roundaboutGroup.add(legNorth);

      const legSouth = legNorth.clone();
      legSouth.position.set(0, 0, 70);
      roundaboutGroup.add(legSouth);

      roadGroup.add(roundaboutGroup);

      // 4. Commercial Entrance off W 200 N into 6-Acre Hotel Site (X = -2)
      const entranceGeo = new THREE.PlaneGeometry(42, 22);
      entranceGeo.rotateX(-Math.PI / 2);
      const entrance = new THREE.Mesh(entranceGeo, roadMat);
      entrance.position.set(-2, 0.47, -20);
      roadGroup.add(entrance);

      // Entrance Splitter Island with directional markings
      const splitGeo = new THREE.BoxGeometry(3.5, 0.45, 16);
      const splitMat = new THREE.MeshStandardMaterial({ color: COLORS.curb, roughness: 0.4 });
      const split = new THREE.Mesh(splitGeo, splitMat);
      split.position.set(-2, 0.65, -18);
      roadGroup.add(split);
    }

    function buildNorthHancockHealthCampus() {
      const hospitalGroup = new THREE.Group();
      hospitalGroup.position.set(-130, 0, -180);

      // Main Multi-Wing Medical Building
      const bldg1Geo = new THREE.BoxGeometry(90, 26, 60);
      const bldg1Mat = new THREE.MeshStandardMaterial({
        color: COLORS.hancockHospital,
        roughness: 0.35,
        metalness: 0.2
      });
      const bldg1 = new THREE.Mesh(bldg1Geo, bldg1Mat);
      bldg1.position.set(0, 13, 0);
      bldg1.castShadow = true;
      bldg1.userData = {
        name: "Hancock Health Gateway Campus (North)",
        desc: "Regional healthcare facility including medical wellness center, outpatient services, and healthcare offices directly north of W 200 N.",
        specs: "Gross Area: 100,000+ SF | Campus: Hancock Health"
      };
      interactiveObjects.push(bldg1);
      hospitalGroup.add(bldg1);

      // Distinctive Gabled / Angled Roof
      const roofGeo = new THREE.ConeGeometry(38, 12, 4);
      roofGeo.rotateY(Math.PI / 4);
      const roofMat = new THREE.MeshStandardMaterial({ color: COLORS.hancockRoof, roughness: 0.6 });
      const roof = new THREE.Mesh(roofGeo, roofMat);
      roof.position.set(0, 32, 0);
      hospitalGroup.add(roof);

      // Medical Center Parking Lot
      const hospPkgGeo = new THREE.PlaneGeometry(160, 90);
      hospPkgGeo.rotateX(-Math.PI / 2);
      const hospPkg = new THREE.Mesh(hospPkgGeo, new THREE.MeshStandardMaterial({ color: 0x242a36, roughness: 0.8 }));
      hospPkg.position.set(0, 0.5, 60);
      hospitalGroup.add(hospPkg);

      northGroup.add(hospitalGroup);

      // Residential / Villa Rows (West of Hospital)
      for (let r = 0; r < 2; r++) {
        for (let c = 0; c < 8; c++) {
          const villaGeo = new THREE.BoxGeometry(10, 6, 12);
          const villaMat = new THREE.MeshStandardMaterial({ color: 0x94a3b8, roughness: 0.5 });
          const villa = new THREE.Mesh(villaGeo, villaMat);
          villa.position.set(-180 + c * 14, 3, -135 - r * 18);
          villa.castShadow = true;
          northGroup.add(villa);
        }
      }

      // Decorative Retention Lake with Aeration Fountain
      const lakeGeo = new THREE.PlaneGeometry(70, 110, 16, 16);
      lakeGeo.rotateX(-Math.PI / 2);
      const lakeMat = new THREE.MeshStandardMaterial({
        color: COLORS.northLakeWater,
        roughness: 0.1,
        metalness: 0.85,
        transparent: true,
        opacity: 0.88
      });
      northLakeMesh = new THREE.Mesh(lakeGeo, lakeMat);
      northLakeMesh.position.set(-30, -0.6, -170);
      northLakeMesh.userData = {
        name: "North Gateway Retention Lake",
        desc: "Stormwater lake serving Hancock Health Gateway with lighted aeration fountain.",
        specs: "Surface Area: 1.8 Acres"
      };
      interactiveObjects.push(northLakeMesh);
      northGroup.add(northLakeMesh);

      // Aeration Fountain
      const fountainGeo = new THREE.ConeGeometry(2.5, 8, 8);
      const fountainMat = new THREE.MeshBasicMaterial({ color: 0xe0f2fe, wireframe: true, transparent: true, opacity: 0.7 });
      const fNorth = new THREE.Mesh(fountainGeo, fountainMat);
      fNorth.position.set(-30, 2.5, -170);
      northGroup.add(fNorth);

      // Municipal Water Tower (East of Lake)
      const towerGroup = new THREE.Group();
      towerGroup.position.set(55, 0, -170);

      const standGeo = new THREE.CylinderGeometry(2.2, 3.5, 36, 16);
      const towerMat = new THREE.MeshStandardMaterial({ color: COLORS.waterTower, metalness: 0.5, roughness: 0.3 });
      const stand = new THREE.Mesh(standGeo, towerMat);
      stand.position.y = 18;
      stand.castShadow = true;
      towerGroup.add(stand);

      const tankGeo = new THREE.SphereGeometry(9, 24, 16);
      const tank = new THREE.Mesh(tankGeo, towerMat);
      tank.position.y = 36;
      tank.castShadow = true;
      tank.userData = {
        name: "Municipal Water Tower (North Corridor)",
        desc: "High-capacity municipal water storage providing required pressure for commercial fire suppression and hotel operations.",
        specs: "Capacity: 1.0M Gallons"
      };
      interactiveObjects.push(tank);
      towerGroup.add(tank);

      northGroup.add(towerGroup);
    }

    function buildBuckCreekRiverBed() {
      // Natural Buck Creek running North-South along EAST border (X = 135)
      const creekGeo = new THREE.PlaneGeometry(28, 520, 24, 64);
      creekGeo.rotateX(-Math.PI / 2);

      const pos = creekGeo.attributes.position;
      for (let i = 0; i < pos.count; i++) {
        const z = pos.getZ(i);
        const curveOffset = Math.sin(z * 0.015) * 14;
        pos.setX(i, pos.getX(i) + curveOffset);
      }
      creekGeo.computeVertexNormals();

      const creekMat = new THREE.MeshStandardMaterial({
        color: COLORS.creekWater,
        roughness: 0.12,
        metalness: 0.88,
        transparent: true,
        opacity: 0.92
      });
      creekMesh = new THREE.Mesh(creekGeo, creekMat);
      creekMesh.position.set(135, -6.8, -10);
      creekMesh.userData = {
        name: "Buck Creek Watershed (Eastern Property Boundary)",
        desc: "Natural stream corridor bordering the east of the 6-acre site. Protected by dedicated 50-ft riparian buffer, tree preservation line, and structural retaining wall.",
        specs: "Drainage: Buck Creek to Big Blue River | Eastern Boundary"
      };
      interactiveObjects.push(creekMesh);
      waterGroup.add(creekMesh);

      // Riparian stone boulders along creek banks
      for (let z = -180; z < 180; z += 14) {
        const rockGeo = new THREE.DodecahedronGeometry(1.6 + Math.random() * 1.2, 1);
        const rockMat = new THREE.MeshStandardMaterial({ color: COLORS.riparianStone, roughness: 0.9 });
        const rock1 = new THREE.Mesh(rockGeo, rockMat);
        rock1.position.set(122 + Math.sin(z * 0.015) * 14 + (Math.random() - 0.5) * 4, -5.2, z);
        const rock2 = new THREE.Mesh(rockGeo, rockMat);
        rock2.position.set(148 + Math.sin(z * 0.015) * 14 + (Math.random() - 0.5) * 4, -5.2, z);
        landscapeGroup.add(rock1);
        landscapeGroup.add(rock2);
      }
    }

    function buildRetainingWallsAndDualBasins() {
      const wallMat = new THREE.MeshStandardMaterial({
        color: COLORS.retainingWall,
        roughness: 0.65,
        metalness: 0.2
      });

      // 1. SOUTH RETAINING WALL (With the distinct center jog from the CAD plan!)
      // Left segment (West of center drive: X = -90 to -12, Z = 68)
      const southLeftGeo = new THREE.BoxGeometry(82, 6.5, 3.2);
      const southLeft = new THREE.Mesh(southLeftGeo, wallMat);
      southLeft.position.set(-51, 0.2, 68);
      southLeft.castShadow = true;
      southLeft.receiveShadow = true;
      retainingGroup.add(southLeft);

      // Center Jog (Turns south from Z=68 to Z=72 at X = -10 to +8)
      const jogGeo = new THREE.BoxGeometry(22, 6.5, 3.2);
      const jog = new THREE.Mesh(jogGeo, wallMat);
      jog.position.set(-1, 0.2, 70);
      jog.rotation.y = 0.22; // Angled transition step
      retainingGroup.add(jog);

